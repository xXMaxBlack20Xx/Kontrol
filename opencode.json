{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "edit": "ask",
    "skill": {
      "kontrol-project-workflow": "allow",
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "npm test*": "allow",
      "npx expo-doctor*": "allow",
      "npx expo install --check*": "allow",
      "npx expo install --fix*": "ask",
      "npm install*": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "git push*": "deny"
    }
  }
}