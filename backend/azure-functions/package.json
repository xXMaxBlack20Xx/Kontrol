{
  "name": "kontrol-azure-functions",
  "version": "1.0.0",
  "private": true,
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "cosmos:setup": "npm run build && node dist/src/scripts/ensureCosmos.js",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run build",
    "start": "func start",
    "test": "npm run build"
  },
  "dependencies": {
    "@azure/cosmos": "^4.5.0",
    "@azure/functions": "4.7.2",
    "@azure/storage-blob": "^12.31.0",
    "argon2": "^0.44.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
